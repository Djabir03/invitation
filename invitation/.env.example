# Variables d'environnement Supabase
# Copier ce fichier vers .env.local et renseigner les valeurs.

# URL publique du projet Supabase (visible dans le navigateur)
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co

# URL publique du site, sans slash final.
# Sert de base au lien de confirmation d'e-mail : <site>/auth/confirmation.
# En production, renseigner le domaine réel et l'ajouter aux "Redirect URLs"
# dans Supabase (Authentication > URL Configuration).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Clé anonyme publique Supabase (visible dans le navigateur)
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre_cle_anon_publique

# Clé service_role Supabase.
# ATTENTION : cette clé ne doit JAMAIS être exposée au navigateur ni committée
# dans Git. Elle est réservée au code serveur (fichiers important "server-only").
SUPABASE_SERVICE_ROLE_KEY=votre_cle_service_role_secrete
